  const TIERS = [{ t: 1, pct: 35, n: 2, min: 0 }, { t: 2, pct: 50, n: 2, min: 0 }, { t: 3, pct: 65, n: 5, min: 35 }, { t: 4, pct: 82, n: 7, min: 55, dose: true }];
  function unmet(st, pct, r) {
    const n = st.exitAfter || 7, m = Math.min(...lvlPcts(st)) * 100, d = st.dosimetry || {}, o = [];
    if (r.t === 1 && n >= 7) return o;   // quien termina los 7 niveles siempre obtiene al menos el primer rango
    if (pct < r.pct) o.push(`${r.pct} % de desempeño (tienes ${pct} %)`);
    if (n < r.n) o.push(r.n === 7 ? "llegar y completar el nivel 7" : `completar ${r.n} niveles (hiciste ${n})`);
    if (m < r.min) o.push(`ningún nivel por debajo de ${r.min} %`);
    if (r.dose && d.everOver && !d.notified) o.push("avisar al Físico Médico si se excede la dosis");
    return o;
  }
