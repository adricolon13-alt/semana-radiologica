  const FR = PAIRS.slice().sort((a, b) => b[0].length - a[0].length);
  const SKIP = new Set(["SCRIPT", "STYLE", "NOSCRIPT"]), ATTRS = ["placeholder", "aria-label", "alt", "title"];
  const LANG0 = (() => { try { const v = localStorage.getItem("xray-lang"); if (v) return v; } catch (e) { /* sin almacenamiento */ } return /^en/i.test(navigator.language || "") ? "en" : "es"; })();
  window.XRayLang = LANG0;
  const nodeRec = new WeakMap(), attrRec = new WeakMap();
  const trText = (t) => { const k = t.trim(); if (!k) return t; if (Object.prototype.hasOwnProperty.call(EXACT, k)) return t.replace(k, EXACT[k]); let o = t; for (const [a, b] of FR) if (o.indexOf(a) >= 0) o = o.split(a).join(b); return o; };
  const skipEl = (el) => !el || SKIP.has((el.nodeName || "").toUpperCase()) || (el.closest && el.closest(".player,#playerPill,#nameInput,#lastInput,input"));
  function doText(n) {
    if (skipEl(n.parentElement)) return; const r = nodeRec.get(n);
    if (window.XRayLang === "en") { if (r && n.data === r.en) return; const en = trText(n.data); if (en !== n.data) { nodeRec.set(n, { es: n.data, en }); n.data = en; } else if (r) nodeRec.delete(n); }
    else if (r && n.data === r.en) { n.data = r.es; nodeRec.delete(n); }
  }
  function doAttrs(el) {
    if (!el.getAttribute || SKIP.has((el.nodeName || "").toUpperCase())) return; let rec = attrRec.get(el) || {};
    ATTRS.forEach((a) => { const v = el.getAttribute(a); if (v == null) return; const r = rec[a];
      if (window.XRayLang === "en") { if (r && v === r.en) return; const en = trText(v); if (en !== v) { rec[a] = { es: v, en }; el.setAttribute(a, en); } }
      else if (r && v === r.en) { el.setAttribute(a, r.es); delete rec[a]; } });
    attrRec.set(el, rec);
  }
  function apply(root) {
    const w = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT); let n = root.nodeType === 3 ? root : w.currentNode;
    const list = []; if (root.nodeType === 3) list.push(root); else { do { list.push(n); } while ((n = w.nextNode())); }
    list.forEach((x) => { if (x.nodeType === 3) doText(x); else if (x.nodeType === 1) doAttrs(x); });
  }
