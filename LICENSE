  document.body.appendChild(con);
  function paint() {
    const d = D(), p = d.mSv / LIM, s = p >= 1 ? "over" : p >= .7 ? "warn" : "ok";
    con.dataset.s = s; $("cnVal").textContent = d.mSv.toFixed(2); $("cnFill").style.width = Math.min(100, p * 100) + "%";
    $("cnSt").textContent = { ok: "NORMAL", warn: "PRECAUCIÓN", over: "¡LÍMITE EXCEDIDO!" }[s]; $("cnAlert").classList.toggle("hidden", s !== "over");
  }
  function shot(k, m) {   // dosis simulada por disparo: crece con kVp² y mAs
    const d = D(), x = 0.02 + Math.pow(k / 80, 2) * (m / 10) * 0.08; d.mSv += x; d.total += x;
    if (d.mSv >= LIM) d.everOver = true; paint(); if (d.mSv >= LIM) lockOut();
  }
  const openDlg = () => { const d = D(); $("cnMsg").textContent = d.mSv >= LIM ? `Físico Médico: lectura de ${d.mSv.toFixed(2)} mSv, por encima del límite. Se registra el incidente y se reinicia tu dosímetro tras la revisión.` : `Físico Médico: la lectura actual (${d.mSv.toFixed(2)} mSv) quedará registrada y el dosímetro volverá a 0.`; $("cnDlg").classList.remove("hidden"); };
  $("cnReset").addEventListener("click", openDlg); $("cnAlert").addEventListener("click", openDlg); $("cnNo").addEventListener("click", () => $("cnDlg").classList.add("hidden"));
  $("cnOk").addEventListener("click", () => { const d = D(); d.log.push(+d.mSv.toFixed(2)); d.resets++; if (d.everOver) d.notified = true; d.mSv = 0; $("cnDlg").classList.add("hidden"); paint(); });
  window.addEventListener("xray:level-complete", () => { const c = (S().calibrations || []).slice(-1)[0]; if (c && c.level === 1 && c.reason !== "timeout") shot(c.selectedKvp, 10); });
  $("setupForm").addEventListener("submit", () => { con.classList.remove("hidden"); document.body.classList.add("has-console"); paint(); Music.start(); });
  const hideConsole = () => { con.classList.add("hidden"); document.body.classList.remove("has-console"); };
 
  /* ===================== MÚSICA AMBIENTAL (clínica, suave) ===================== */
  const Music = (() => {
    let ctx, out, on = true, started = false, i = 0;
    const CH = [[261.63, 329.63, 392, 493.88], [220, 261.63, 329.63, 392], [174.61, 261.63, 329.63, 440], [196, 246.94, 293.66, 392]], BELL = [523.25, 587.33, 659.25, 784, 880];
    const pad = () => { const t = ctx.currentTime; CH[i++ % 4].forEach((f) => [-6, 6].forEach((c) => { const o = ctx.createOscillator(), g = ctx.createGain(); o.type = "triangle"; o.frequency.value = f; o.detune.value = c; g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(0.05, t + 2.5); g.gain.linearRampToValueAtTime(0.0001, t + 9); o.connect(g); g.connect(out); o.start(t); o.stop(t + 9.2); })); };
    const bell = () => { if (Math.random() < .5) return; const t = ctx.currentTime, o = ctx.createOscillator(), g = ctx.createGain(); o.type = "sine"; o.frequency.value = BELL[Math.floor(Math.random() * 5)]; g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.045, t + 0.05); g.gain.exponentialRampToValueAtTime(0.0001, t + 3); o.connect(g); g.connect(out); o.start(t); o.stop(t + 3.1); };
    return {
      start() {
        if (started) { if (ctx.state === "suspended") ctx.resume(); return; }
        try {
          const A = window.AudioContext || window.webkitAudioContext; if (!A) return; ctx = new A(); started = true;
          const f = ctx.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = 1100; out = ctx.createGain(); out.gain.value = on ? 0.5 : 0; out.connect(f); f.connect(ctx.destination);
          pad(); setInterval(pad, 8000); setInterval(bell, 3500);
        } catch (e) { /* el audio es opcional */ }
      },
      toggle() { on = !on; if (out) out.gain.setTargetAtTime(on ? 0.5 : 0, ctx.currentTime, 0.2); return on; }
    };
  })();
  $("cnMusic").addEventListener("click", () => { Music.start(); $("cnMusic").textContent = "♪ " + (Music.toggle() ? "On" : "Off"); });
 
