        .secondary-btn { width: 100%; margin-top: 16px; min-height: 52px; border: 1px solid var(--neon); border-radius: 12px; background: transparent; color: var(--neon); font-weight: 850; transition: background .2s, color .2s; }
        .secondary-btn:hover { background: var(--neon); color: #062116; }
