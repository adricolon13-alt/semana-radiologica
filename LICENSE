    <script>
        (() => {
            "use strict";
 
            const $ = (id) => document.getElementById(id);
            const welcomeScreen = $("welcomeScreen");
            const gameScreen = $("gameScreen");
            const setupForm = $("setupForm");
            const nameInput = $("nameInput");
            const startButton = $("startButton");
            const kvSlider = $("kvSlider");
            const kvReadout = $("kvReadout");
            const timerValue = $("timerValue");
            const timerBox = $("timerBox");
            const timeProgress = $("timeProgress");
            const timeLeftLabel = $("timeLeftLabel");
            const shootButton = $("shootButton");
            const resultPanel = $("resultPanel");
            const toast = $("toast");
 
            let countdownInterval = null;
            let startedAt = 0;
            let remainingMs = 15000;
            let hasMovedSlider = false;
            let firstMoveAt = null;
            let finished = false;
            let toastTimeout = null;
 
            function showToast(message) {
                toast.textContent = message;
                toast.classList.add("show");
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => toast.classList.remove("show"), 2500);
            }
 
            function playPhotonSound() {
                try {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (!AudioContextClass) return;
                    const context = new AudioContextClass();
                    const oscillator = context.createOscillator();
                    const gain = context.createGain();
                    oscillator.type = "sine";
                    oscillator.frequency.setValueAtTime(880, context.currentTime);
                    oscillator.frequency.exponentialRampToValueAtTime(220, context.currentTime + 0.22);
                    gain.gain.setValueAtTime(0.0001, context.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.12, context.currentTime + 0.025);
                    gain.gain.exponentialRampToValueAtTime(0.0001, context.currentTime + 0.28);
                    oscillator.connect(gain);
                    gain.connect(context.destination);
                    oscillator.start();
                    oscillator.stop(context.currentTime + 0.3);
                    oscillator.addEventListener("ended", () => context.close().catch(() => {}), { once: true });
                } catch (error) {
                    // El sonido es opcional; el juego sigue funcionando si el navegador lo bloquea.
                }
            }
 
            function photonTransition() {
                const flash = $("photonFlash");
                flash.classList.remove("fire");
                void flash.offsetWidth;
                flash.classList.add("fire");
                playPhotonSound();
            }
 
            function beginGame() {
                const playerName = (nameInput.value.trim() + " " + document.getElementById("lastInput").value.trim()).trim() || "Tecnólogo Anónimo";
                window.XRayGameState = {
                    score: 0,
                    currentLevel: 1,
                    playerName: playerName,
                    badges: [],
                    calibrations: []
                };
 
                welcomeScreen.classList.add("hidden");
                gameScreen.classList.remove("hidden");
                $("playerPill").textContent = playerName;
                $("totalScore").textContent = "0 pts";
                photonTransition();
                resetLevel();
                startTimer();
                window.scrollTo({ top: 0, behavior: "smooth" });
            }
 
            function resetLevel() {
                finished = false;
                remainingMs = 15000;
                startedAt = performance.now();
                hasMovedSlider = false;
                firstMoveAt = null;
                kvSlider.value = "80";
                kvReadout.value = "80 kVp";
                kvReadout.textContent = "80 kVp";
                timerValue.textContent = "15.0";
                timerBox.classList.remove("urgent");
                timeProgress.style.width = "100%";
                timeLeftLabel.textContent = "15 s";
                shootButton.disabled = false;
                shootButton.textContent = "⚡ Fijar Disparo";
                shootButton.style.opacity = "1";
                resultPanel.classList.add("hidden");
                $("gameGrid").classList.remove("hidden");
            }
 
            function startTimer() {
                clearInterval(countdownInterval);
                startedAt = performance.now();
                countdownInterval = setInterval(() => {
                    if (finished) return;
                    remainingMs = Math.max(0, 15000 - (performance.now() - startedAt));
                    const seconds = remainingMs / 1000;
                    timerValue.textContent = seconds.toFixed(1);
                    timeLeftLabel.textContent = `${Math.ceil(seconds)} s`;
                    timeProgress.style.width = `${(remainingMs / 15000) * 100}%`;
                    timerBox.classList.toggle("urgent", remainingMs <= 3000);
                    if (remainingMs <= 0) finishRound("timeout");
                }, 50);
            }
 
            function scorePrecision(value) {
                const distance = Math.abs(value - 100);
                if (distance <= 2) return 700;
                if (distance <= 5) return 500;
                if (distance <= 10) return 300;
                return 100;
            }
 
            function finishRound(reason) {
                if (finished) return;
                finished = true;
                clearInterval(countdownInterval);
                remainingMs = reason === "timeout" ? 0 : Math.max(0, 15000 - (performance.now() - startedAt));
 
                const value = Number(kvSlider.value);
                const elapsedSeconds = Math.min(15, Math.max(0, (performance.now() - startedAt) / 1000));
                const precision = scorePrecision(value);
                const coverage = hasMovedSlider && firstMoveAt !== null && (performance.now() - firstMoveAt) >= 3000 ? 200 : 0;
                const speed = reason === "shot" && remainingMs > 0 ? 100 : 0;
                const earned = precision + coverage + speed;
 
                window.XRayGameState.score += earned;
                window.XRayGameState.calibrations.push({
                    level: 1,
                    object: "Bulto con laptop y termo",
                    selectedKvp: value,
                    targetKvp: 100,
                    elapsedSeconds: Number(elapsedSeconds.toFixed(2)),
                    reason: reason,
                    points: { precision: precision, coverage: coverage, speed: speed, total: earned }
                });
 
                if (earned > 500 && !window.XRayGameState.badges.includes("Explorador Inicial")) {
                    window.XRayGameState.badges.push("Explorador Inicial");
                }
 
                $("totalScore").textContent = `${window.XRayGameState.score} pts`;
                $("earnedScore").textContent = `+${earned} pts`;
                $("precisionPoints").textContent = `${precision} / 700`;
                $("coveragePoints").textContent = `${coverage} / 200`;
                $("speedPoints").textContent = `${speed} / 100`;
                $("resultTitle").textContent = reason === "timeout" ? "¡Tiempo finalizado!" : "¡Disparo fijado!";
 
                const badgeContainer = $("badgeContainer");
                badgeContainer.replaceChildren();
                if (window.XRayGameState.badges.includes("Explorador Inicial")) {
                    const badge = document.createElement("div");
                    badge.className = "badge-chip";
                    badge.textContent = "🏅 Insignia desbloqueada: Explorador Inicial";
                    badgeContainer.appendChild(badge);
                }
 
                shootButton.disabled = true;
                shootButton.style.opacity = ".55";
                $("gameGrid").classList.add("hidden");
                resultPanel.classList.remove("hidden");
                showToast(`Calibración registrada: +${earned} puntos`);
                window.dispatchEvent(new CustomEvent("xray:level-complete", { detail: { ...window.XRayGameState } }));
            }
 
            function handoffToNextLevel() {
                // Punto de extensión: el Nivel 02 puede escuchar este evento o reemplazar esta función.
                // El objeto global se conserva y no se reinicializa durante la transición.
                window.dispatchEvent(new CustomEvent("xray:next-level", {
                    detail: { state: window.XRayGameState, nextLevel: 2 }
                }));
                if (typeof window.XRayNextLevel === "function") {
                    window.XRayNextLevel(window.XRayGameState);
                } else {
                    showToast("Estado conservado. Nivel 02 listo para integrarse.");
                    console.info("X-Ray Challenge: entrega de control al Nivel 02.", window.XRayGameState);
                }
            }
 
            setupForm.addEventListener("submit", (event) => {
                event.preventDefault();
                startButton.disabled = true;
                beginGame();
                startButton.disabled = false;
            });
 
            kvSlider.addEventListener("input", () => {
                if (finished) return;
                hasMovedSlider = true;
                if (firstMoveAt === null) firstMoveAt = performance.now();
                kvReadout.value = `${kvSlider.value} kVp`;
                kvReadout.textContent = `${kvSlider.value} kVp`;
            });
 
            shootButton.addEventListener("click", () => finishRound("shot"));
            $("nextLevelButton").addEventListener("click", handoffToNextLevel);
 
            // API pública opcional para integrar el Nivel 02 sin alterar el estado de la partida.
            window.XRayGame = window.XRayGame || {};
            window.XRayGame.handoffToNextLevel = handoffToNextLevel;
        })();
    </script>
