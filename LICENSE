  /* ---- firma aleatoria (sin nombre) ---- */
  function rng(seed) { let a = 0; for (const ch of String(seed)) a = (a * 31 + ch.charCodeAt(0)) >>> 0; return () => { a = (a + 0x6D2B79F5) >>> 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
  function sigSVG(seed) {
    const r = rng(seed); let x = 8, y = 34, d = `M${x} ${y}`; const n = 5 + Math.floor(r() * 3);
    for (let i = 0; i < n; i++) { const dx = 22 + r() * 18, a = 14 + r() * 22, up = r() < .5 ? -1 : 1; d += ` C${(x + dx * .2).toFixed(1)} ${(y - up * a * 1.6).toFixed(1)} ${(x + dx * .7).toFixed(1)} ${(y + up * a * 1.2).toFixed(1)} ${(x + dx).toFixed(1)} ${(y + (r() - .5) * 14).toFixed(1)}`; x += dx; y = Math.min(46, Math.max(18, y + (r() - .5) * 14)); }
    d += ` q ${(8 + r() * 10).toFixed(1)} ${(r() * 6).toFixed(1)} ${(20 + r() * 14).toFixed(1)} ${(-6 - r() * 8).toFixed(1)}`;
    const u = `M6 ${(50 + r() * 4).toFixed(1)} Q ${(x / 2).toFixed(1)} ${(44 + r() * 8).toFixed(1)} ${(x + 10).toFixed(1)} ${(48 + r() * 6).toFixed(1)}`;
    return `<svg viewBox="0 0 ${Math.ceil(x + 50)} 64" fill="none" stroke="#1b2a5a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/><path d="${u}" stroke-width="1.6"/></svg>`;
  }
  function signFill(sign, sig, seed) { const dra = rng(seed + "g")() < .5; sign.innerHTML = sigSVG(seed); sig.innerHTML = `${dra ? "Dra." : "Dr."} · ${dra ? "Médica Radióloga" : "Médico Radiólogo"}<br>Servicio de Imagenología`; }
 
