  });
 
  /* Punto de entrada que ya invoca la Fase 1 en su botón “Proceder al Nivel 02” */
  window.XRayNextLevel = () => brief(2, () => runLevel(L2));
  window.XRayLevels = { startLevel02: () => runLevel(L2), startLevel03: () => runLevel(L3), startLevel04: () => runLevel4(), startLevel05: () => runPhoto(L5), startLevel06: () => runPhoto(L6), startLevel07: () => runPhoto(L7), showFinal };
})();
</script>
 
</body>
</html>

