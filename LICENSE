  function runLevel(c) {
    const st = S(); st.currentLevel = c.n;
    $("xrayStage").classList.remove("hidden"); $("xrayFinal").classList.add("hidden");
    ["welcomeScreen", "gameScreen"].forEach((id) => $(id) && $(id).classList.add("hidden"));
    const box = $("xray-level-container"); box.classList.remove("hidden");
    box.innerHTML = `<div class="xray-header"><h2 class="xray-title">${c.icon} Nivel 0${c.n} – ${c.title}</h2>
      <div class="xray-meta"><span>Puntos: <strong id="lv-score">${st.score}</strong></span><span class="xray-timer">⏱ <strong id="lv-timer">${fmt(c.time)}</strong></span></div></div>
      <div class="xray-viewer" style="${vstyle(c)}"><img id="lv-img" class="xray-image" src="${c.img}" alt="${c.alt}">${c.circle ? '<div id="lv-circle" class="xray-overlay-circle amber"></div>' : ""}</div>
      <div class="xray-controls"><div class="xray-slider-row"><label for="lv-slider">kVp</label>
      <input type="range" id="lv-slider" class="xray-slider" min="40" max="120" value="${c.start}" step="1"><span id="lv-kvp" class="xray-kvp-value">${c.start} kVp</span></div>
      <button id="lv-go" class="xray-btn xray-btn-primary" type="button">⚡ Calibrar y Adquirir Imagen</button></div>
      <div id="lv-fb" class="xray-feedback" aria-live="polite"></div>`;
    const slider = $("lv-slider"), img = $("lv-img"), fb = $("lv-fb"), go = $("lv-go");
    let left = c.time, solved = false, timer;
    const inRange = (k) => k >= c.min && k <= c.max;
    const visual = (k) => {
      const d = k < c.min ? c.min - k : k > c.max ? k - c.max : 0;
      const v = c.visual(d, k < c.min ? -1 : 1);
      img.style.filter = `brightness(${v[0]}) contrast(${v[1]})`; img.style.opacity = v[2];
      if (c.circle) $("lv-circle").className = "xray-overlay-circle " + (inRange(k) ? "gold" : "amber");
    };
    const finish = () => {
      solved = true; clearInterval(timer); slider.disabled = true; go.disabled = true; go.textContent = "✓ Imagen adquirida";
      const b = document.createElement("button"); b.type = "button";
      b.className = "xray-btn " + c.nextClass; b.style.marginTop = "1rem"; b.textContent = c.nextLabel;
      b.addEventListener("click", c.next); fb.appendChild(b); fb.appendChild(exitBtn(c.n));
    };
    slider.addEventListener("input", () => { if (solved) return; $("lv-kvp").textContent = `${slider.value} kVp`; visual(+slider.value); });
    go.addEventListener("click", () => {
      if (solved) return;
      const k = +slider.value, diff = Math.abs(k - c.mid);
      let pts = prec(c.mid, k), bonus = 0;
      if (c.bonus && diff <= 3 && left > c.time * 0.4) bonus = 150;
      pts += bonus; st.score += pts; shot(k, 10); $("lv-score").textContent = st.score;
      st.calibrations.push({ level: c.n, selectedKvp: k, targetKvp: c.mid, points: { total: pts, bonus } });
      fb.className = "xray-feedback visible " + (inRange(k) ? "success" : "");
      fb.innerHTML = `<h3>${inRange(k) ? c.okTitle : "Calibración registrada"}</h3><p>+${pts - bonus} puntos base${bonus ? `<span class="xray-bonus">+${bonus} BONUS</span>` : ""} (precisión ±${diff.toFixed(1)} kVp)</p><div class="xray-edu">${c.edu}</div>`;
      finish();
    });
    timer = setInterval(() => {
      left--; $("lv-timer").textContent = fmt(Math.max(0, left));
      if (left <= 0 && !solved) { fb.className = "xray-feedback visible"; fb.innerHTML = "<h3>⏱ Tiempo agotado</h3><p>Se adquirió la imagen con el valor actual, sin puntos. ¡Sigue practicando!</p>"; finish(); }
    }, 1000);
    visual(+slider.value); window.scrollTo({ top: 0, behavior: "smooth" });
  }
 
  const L2 = { n: 2, icon: "✋", title: "La Mano de la Ciencia", img: HAND, ar: "720/744", mw: 560, alt: "Radiografía de mano", start: 80, time: 120, min: 45, max: 55, mid: 50, okTitle: "¡Calibración perfecta!",
    visual: (d, s) => d === 0 ? [1, 1.05, 1] : s < 0 ? [Math.max(0.3, 1 - d / 40), Math.max(0.45, 1.05 - d / 70), Math.max(0.55, 1 - d / 90)] : [1 + Math.min(d / 40, 1.6), Math.max(0.35, 1.05 - d / 45), Math.max(0.6, 1 - d / 120)],
    edu: "<strong>¡27 huesos en una sola mano!</strong> En 1895, Röntgen obtuvo la famosa radiografía de la mano de su esposa Anna Bertha, donde se distinguía su anillo.",
    nextClass: "xray-btn-success", nextLabel: "Continuar al Torso →", next: () => brief(3, () => runLevel(L3)) };
  const L3 = { n: 3, icon: "🫀", title: "El Misterio del Torso", img: TORSO, ar: "560/815", mw: 440, alt: "Radiografía de tórax", circle: true, bonus: true, start: 70, time: 100, min: 85, max: 100, mid: 92.5, okTitle: "¡Buen Diagnóstico!",
    visual: (d, s) => d === 0 ? [1, 1.05, 1] : s < 0 ? [Math.max(0.3, 1 - d / 40), Math.max(0.45, 1.05 - d / 70), 1] : [1 + Math.min(d / 35, 1.6), Math.max(0.35, 1.05 - d / 45), 1],
    edu: "<strong>¡Un corazón entre sombras!</strong> El corazón se ve claro porque atenúa los rayos X, mientras que los pulmones se ven oscuros porque el aire absorbe muy pocos fotones.",
    nextClass: "xray-btn-final", nextLabel: "Desbloquear el Cráneo →", next: () => brief(4, () => runLevel4()) };
 
  /* ---------- Nivel 04: Cráneo Desbloqueado ---------- */
  function runLevel4() {
    const st = S(); st.currentLevel = 4;
    $("xrayStage").classList.remove("hidden"); $("xrayFinal").classList.add("hidden");
    ["welcomeScreen", "gameScreen"].forEach((id) => $(id) && $(id).classList.add("hidden"));
    const box = $("xray-level-container"); box.classList.remove("hidden");
    box.innerHTML = `<div class="xray-header"><div><small style="color:#22d3ee;font-weight:600">Nivel 04 / 07</small><h2 class="xray-title" style="color:#fff">💀 Modo: Cráneo Desbloqueado</h2></div>
      <div class="xr-timer">⏱ <span id="l4-time">14.0</span> s</div></div>
      <div class="xr-alert">⚠️ <strong>Alerta universitaria:</strong> escaneo cerebral en semana de exámenes… ¡buscando neuronas activas! 🧠<small>(Tranquilo: los rayos X convencionales solo muestran el hueso, no tus neuronas quemadas).</small></div>
      <div class="xray-viewer" style="display:grid;place-items:center;aspect-ratio:720/794;max-width:560px;margin-left:auto;margin-right:auto"><div id="l4-plate" class="xr-plate">
        <img class="xray-image" src="${SKULL}" alt="Radiografía de cráneo"></div></div>
      <div class="xray-controls"><div class="xray-slider-row"><label for="l4-slider">kVp</label>
        <input type="range" id="l4-slider" class="xray-slider" min="40" max="120" value="40" step="1"><span id="l4-kvp" class="xray-kvp-value">40 kVp</span></div>
        <div style="display:flex;justify-content:space-between;font:.72rem ui-monospace,monospace;color:#64748b"><span>40 · Subexpuesto</span><span style="color:#22d3ee">Óptimo: 70–80 kVp</span><span>120 · Sobretensión</span></div>
        <button id="l4-go" class="xray-btn xray-btn-primary" type="button">Disparar rayos X y fijar placa</button></div>
      <div id="l4-res" class="xray-feedback" aria-live="polite"></div>`;
    const slider = $("l4-slider"), plate = $("l4-plate"), go = $("l4-go"), res = $("l4-res");
    const DUR = 14000, t0 = performance.now(); let done = false, timer;
    const visual = () => {
      const k = +slider.value; $("l4-kvp").textContent = `${k} kVp`;
      let c = Math.min(100, Math.max(20, (k / 80) * 100)), o = Math.min(1, Math.max(0.2, k / 75));
      if (k >= 70 && k <= 80) { o = 1; c = 90; }
      plate.style.filter = `contrast(${c}%) brightness(${k > 80 ? 1 + (k - 80) / 35 : 1})`; plate.style.opacity = o;
    };
    const shoot = (timeout) => {
      if (done) return; done = true; clearInterval(timer);
      const left = timeout ? 0 : Math.max(0, DUR - (performance.now() - t0)) / 1000;
      const k = +slider.value, d = Math.abs(k - 75), ok = k >= 70 && k <= 80;
      const precision = d === 0 ? 700 : d <= 5 ? 700 - d * 40 : Math.max(50, 700 - d * 25);
      const coverage = ok ? 200 : Math.max(40, 200 - d * 10);
      const speed = timeout ? 0 : Math.round((left / 14) * 100);
      const total = precision + coverage + speed;
      st.score += total; shot(k, 10);
      st.calibrations.push({ level: 4, object: "Cráneo humano", selectedKvp: k, targetKvp: 75, reason: timeout ? "timeout" : "shot", points: { precision, coverage, speed, total } });
      if (total > 850 && !st.badges.includes("Especialista en Hardware Biológico")) st.badges.push("Especialista en Hardware Biológico");
      slider.disabled = true; go.disabled = true; go.textContent = "✓ Placa fijada";
      const msg = ok ? "¡Exposición perfecta! El contraste óseo del cráneo es óptimo para diagnóstico." : k < 70 ? "Placa subexpuesta (falta de penetración del haz primario)." : "Placa sobreexpuesta (exceso de radiación secundaria dispersa).";
      res.className = "xray-feedback visible " + (ok ? "success" : "");
      res.innerHTML = `<h3>📊 Dictamen radiológico</h3><p>${timeout ? "Tiempo agotado. " : ""}Disparo registrado a ${k} kVp. ${msg}</p>
        <div class="xr-stats"><div>Precisión<strong>${precision}/700</strong></div><div>Cobertura<strong>${coverage}/200</strong></div><div>Velocidad<strong>${speed}/100</strong></div></div>
        <p>Total del nivel: <strong>+${total} pts</strong> · Acumulado: <strong>${st.score} pts</strong></p>`;
      const b = document.createElement("button"); b.type = "button"; b.className = "xray-btn xray-btn-final"; b.style.marginTop = "1rem";
      b.textContent = "Continuar al Nivel 05: Tobillo doloroso →";
      b.addEventListener("click", () => brief(5, () => runPhoto(L5)));
      res.appendChild(b); res.appendChild(exitBtn(4));
    };
    slider.addEventListener("input", () => { if (!done) visual(); });
    go.addEventListener("click", () => shoot(false));
    timer = setInterval(() => {
      const r = Math.max(0, (DUR - (performance.now() - t0)) / 1000); $("l4-time").textContent = r.toFixed(1);
      if (r <= 0) shoot(true);
    }, 100);
    visual(); window.scrollTo({ top: 0, behavior: "smooth" });
  }
 
  /* ===================== MANDO DE CONTROL · DOSÍMETRO ===================== */
  const LIM = 1.0;   // mSv de turno (simulado, con fines educativos)
