  function renderFinal() {
    const st = S(), score = Math.max(0, Math.round(Number(st.score) || 0));
    const name = String(st.playerName || "").trim() || "Tecnólogo Anónimo";
    const pct = globalPct(st), tier = tierFor(st, pct); const vt = viewTier && viewTier <= tier ? viewTier : tier; const r = RANKS[Math.max(1, vt) - 1]; applyQual(st, pct); gallery(st, pct, tier);
    const when = new Date(st.completedAt); const date = isNaN(when) ? new Date() : when;
    let h = 5381; (name + "|" + score).split("").forEach((ch) => { h = ((h << 5) + h + ch.charCodeAt(0)) >>> 0; });
    $("certificate").dataset.tier = r.tier; $("certificate").dataset.theme = themes[vt] || "auto"; paintThemes(); $("xrayFinal").style.setProperty("--accent", r.accent);
