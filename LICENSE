  con.innerHTML = `<div class="cn-l"><span class="cn-led"></span><div><small>DOSÍMETRO PERSONAL · LÍMITE ${LIM.toFixed(1)} mSv</small><div class="cn-lcd"><b id="cnVal">0.00</b> mSv · <span id="cnSt">NORMAL</span></div></div></div>
