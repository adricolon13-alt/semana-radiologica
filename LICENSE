    $("cDate").textContent = (window.XRayLang === "en" ? "Issued on " : "Emitido el ") + date.toLocaleDateString(window.XRayLang === "en" ? "en-US" : "es", { day: "numeric", month: "long", year: "numeric" });
    const acq = (st.calibrations || []).length, bd = (st.badges || []).join(", ");
