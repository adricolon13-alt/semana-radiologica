  const MAXP = { 1: 1000, 2: 700, 3: 850, 4: 1000, 5: 1000, 6: 1000, 7: 1000 };
  function lvlPcts(st) { const o = {}; (st.calibrations || []).forEach((c) => { const t = (c.points && c.points.total) || 0; o[c.level] = Math.max(o[c.level] || 0, Math.pow(Math.min(1, t / MAXP[c.level]), 1.1)); }); return [1, 2, 3, 4, 5, 6, 7].slice(0, st.exitAfter || 7).map((n) => o[n] || 0); }
  function globalPct(st) { const n = st.exitAfter || 7; let v = lvlPcts(st).reduce((a, b) => a + b, 0) / n * 100; const d = st.dosimetry; if (d && d.everOver && !d.notified) v -= 5; return Math.max(0, Math.round(v)); }
  function tierFor(st, pct) { let t = 0; TIERS.forEach((r) => { if (!unmet(st, pct, r).length) t = r.t; }); return t; }
 
